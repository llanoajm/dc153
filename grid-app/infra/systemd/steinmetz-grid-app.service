[Unit]
Description=Steinmetz grid-app (Next.js production server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent
Group=agent
WorkingDirectory=/home/agent/grid-app
ExecStart=/home/agent/grid-app/scripts/systemd/run-grid-app.sh
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
