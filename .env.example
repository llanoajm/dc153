# grid-app environment template. Copy to .env.local and fill in.
# .env.local is gitignored; never commit secrets.

# --- Supabase ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# --- opencode (HARDENING §1.2) -------------------------------------------
# grid-app talks to the bearer-auth fronting proxy, never raw opencode.
# Launch the proxy with:
#   STEINMETZ_OPENCODE_TOKEN=<same-value-as-below> \
#     ~/.bun/bin/bun run scripts/opencode-proxy.ts
# Generate a token with: openssl rand -hex 32
STEINMETZ_OPENCODE_URL=http://127.0.0.1:4097
STEINMETZ_OPENCODE_TOKEN=<32+ hex chars; identical to the one the proxy boots with>

# --- Filesystem ----------------------------------------------------------
GRID_WORKSPACE_ROOT=/home/agent/grid-workspaces

# --- Provider keys (HARDENING §1.4) --------------------------------------
# The shared OpenRouter key still lives in the opencode server's env (it's
# the fallback when a user has no per-user key configured). Per-user keys
# pasted at /app/settings land in the `provider_keys` table, AES-256-GCM
# encrypted at rest with the secret below. Generate one with:
#   openssl rand -hex 32
# grid-app refuses to upsert or decrypt a per-user key without this set.
# Rotating it invalidates every stored key — users will need to re-paste.
STEINMETZ_PROVIDER_KEYS_SECRET=<64 hex chars; AES-256-GCM key>

# --- Internal admission token (HARDENING §2.2) ---------------------------
# Shared bearer used by the MCP server (scripts/user-mcp-server.py) and the
# detached-spawn upload routes to call grid-app's /api/internal/proceed and
# /api/internal/release endpoints (the `may_I_proceed()` token-bucket gate).
# Set the SAME value in:
#   - grid-app/.env.local                (Next.js reads STEINMETZ_INTERNAL_TOKEN)
#   - opencode server env                (so the MCP subprocess inherits it)
# Generate one with: openssl rand -hex 32
STEINMETZ_INTERNAL_TOKEN=<32+ hex chars; shared with the MCP server>

# Where the MCP server / upload scripts reach grid-app's internal endpoints.
# Defaults to http://127.0.0.1:3000 — leave alone unless dev server moves.
# STEINMETZ_GRID_APP_URL=http://127.0.0.1:3000

# Concurrency caps for /api/internal/proceed. Defaults: 1 per user, 3 global.
# STEINMETZ_CONCURRENCY_PER_USER=1
# STEINMETZ_CONCURRENCY_GLOBAL=3
# Default expected runtime before a stalled slot is reclaimed (ms).
# STEINMETZ_CONCURRENCY_DEFAULT_DEADLINE_MS=600000
# STEINMETZ_CONCURRENCY_GRACE_MS=30000
