# grid-app environment template. Copy to .env.local and fill in.
# .env.local is gitignored; never commit secrets.

# --- Supabase ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# --- opencode (HARDENING §1.2) -------------------------------------------
# grid-app talks to the bearer-auth fronting proxy, never raw opencode.
# Launch the proxy with:
#   STEINMETZ_OPENCODE_TOKEN=<same-value-as-below> \
#     ~/.bun/bin/bun run scripts/opencode-proxy.ts
# Generate a token with: openssl rand -hex 32
STEINMETZ_OPENCODE_URL=http://127.0.0.1:4097
STEINMETZ_OPENCODE_TOKEN=<32+ hex chars; identical to the one the proxy boots with>

# --- Filesystem ----------------------------------------------------------
GRID_WORKSPACE_ROOT=/home/agent/grid-workspaces

# --- Provider keys -------------------------------------------------------
# The OpenRouter key lives in the opencode server's env, not grid-app's.
# Per-user keys land in the `provider_keys` table once HARDENING §1.4 ships.
